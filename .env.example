# Copy to .env and fill in. .env is git-ignored, and agents are not allowed to read it.
# The names are the same as in geo-skills' .env.example. Fill in only what you use.

# Publishing to Geo: geo-publish, geo-clean, geo-claim-grouping, geo-mirror Part 2.
# Get the private key for your Geo account at https://www.geobrowser.io/export-wallet.
# Never paste it into a chat.
GEO_PRIVATE_KEY=
# Your personal space id: the long hex string in geobrowser.io/space/<this part>.
DEMO_SPACE_ID=

# geo-publish "inject mode" (publishing a news story from a URL). Ask a maintainer for the key.
INJECT_BASE_URL=https://news-worker-production.up.railway.app
INJECT_API_KEY=

# Notion: geo-mirror, geo-mirror-refresh and the other Notion skills.
# In Notion: ... → Connections → Developer portal → + New connection → Access token.
NOTION_TOKEN=
