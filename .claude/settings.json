{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(node tools/*)",
      "Bash(node --test tools/*)",
      "Bash(node agents/*/scripts/*)",
      "Bash(node --env-file=.env agents/*/scripts/*)",
      "Bash(npm ci)",
      "Bash(npm ci *)"
    ],
    "ask": [
      "Bash(node tools/sync-skills.mjs*)",
      "Bash(node tools/update.mjs)",
      "Bash(node tools/setup-clone.mjs)",
      "Bash(* --publish *)",
      "Bash(* --publish)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(cat .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(*restart-required*)",
      "Write(runs/.restart-required.json)",
      "Edit(runs/.restart-required.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Agent|Task|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/restart-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
